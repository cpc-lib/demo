# Generate a random 32-byte signing key using the PowerShell 5.1-compatible commands in README.md.
# Keep the real .env out of Git.
JWT_SECRET_BASE64=
# Mobile Vite is an independent application at 5173/ (no /mobile prefix).
# For public phones set the independent trusted HTTPS Mobile origin instead:
# SCAN_URL=https://YOUR_TRUSTED_MOBILE_HOST/
SCAN_URL=http://localhost:5173/
# Set true when deploying behind HTTPS.
SECURE_COOKIE=false
