<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>sha256-distributed-demo-v1</artifactId>
    <version>3.0.0</version>
    <packaging>pom</packaging>
    <name>sha256-distributed-demo</name>
    <description>Distributed asynchronous SHA-256 service with Redis + RabbitMQ/Kafka + Worker</description>

    <modules>
        <module>sha256-common</module>
        <module>sha256-api</module>
        <module>sha256-worker</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <aws.sdk.version>2.41.26</aws.sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
