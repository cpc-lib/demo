# MySQL 8.0.36
MYSQL_ROOT_PASSWORD=root123456
MYSQL_HOST_PORT=3306

# PowerJob database
POWERJOB_DB_NAME=powerjob
POWERJOB_DB_USER=powerjob
POWERJOB_DB_PASSWORD=PowerJob123456

# PowerJob 4.3.9 ports exposed by the VMware virtual machine
POWERJOB_WEB_HOST_PORT=7700
POWERJOB_HTTP_HOST_PORT=10010
POWERJOB_AKKA_HOST_PORT=10086

# Address reachable from the Windows Worker.
# Current VMware virtual-machine IP provided by the user.
POWERJOB_EXTERNAL_ADDRESS=192.168.220.200

POWERJOB_JVM_OPTIONS=-Xms256m -Xmx512m -XX:+UseG1GC
