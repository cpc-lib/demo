<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cc.ivera.mapper.PhotoTypeMapper">

    <!-- 锁同级 -->
    <select id="lockByParent" resultType="cc.ivera.entity.PhotoType">
        SELECT *
        FROM base_photo_type
        WHERE parent_id = #{parentId}
          AND is_deleted = 0
        ORDER BY sort
            FOR UPDATE
    </select>

    <!-- 批量更新排序（核心优化） -->
    <update id="batchUpdateSort">
        UPDATE base_photo_type
        SET sort = CASE id
        <foreach collection="list" item="item">
            WHEN #{item.id} THEN #{item.sort}
        </foreach>
        END
        WHERE id IN
        <foreach collection="list" item="item" open="(" separator="," close=")">
            #{item.id}
        </foreach>
    </update>

</mapper>