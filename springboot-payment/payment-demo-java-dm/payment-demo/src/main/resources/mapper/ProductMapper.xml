<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cc.ivera.mapper.ProductMapper">

    <select id="selectByIdForUpdate" resultType="cc.ivera.entity.Product">
        select *
        from t_product
        where id = #{id}
        for update
    </select>

</mapper>
