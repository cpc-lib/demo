<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cc.ivera.mapper.ProductSkuMapper">

    <select id="selectDefaultByProductId" resultType="cc.ivera.entity.ProductSku">
        select *
        from t_product_sku
        where product_id = #{productId}
        limit 1
    </select>

    <select id="selectDefaultByProductIds" resultType="cc.ivera.entity.ProductSku">
        select *
        from t_product_sku
        where product_id in
        <foreach collection="productIds" item="productId" open="(" separator="," close=")">
            #{productId}
        </foreach>
        order by product_id
    </select>

</mapper>

