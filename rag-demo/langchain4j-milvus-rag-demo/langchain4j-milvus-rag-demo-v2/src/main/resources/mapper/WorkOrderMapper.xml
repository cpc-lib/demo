<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cc.ivera.ragdemo.mapper.WorkOrderMapper">


    <sql id="BaseWhere">
        <where>
            <if test="assigneeId != null and assigneeId != ''">
                AND assignee_id = #{assigneeId}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="priority != null and priority != ''">
                AND priority = #{priority}
            </if>
            <if test="startTime != null">
                AND created_at <![CDATA[>=]]> #{startTime}
            </if>
            <if test="endTime != null">
                AND created_at <![CDATA[<=]]> #{endTime}
            </if>
        </where>
    </sql>

    <select id="countTickets" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM work_order
        WHERE 1 = 1
        <if test="assigneeId != null and assigneeId != ''">
            AND assignee_id = #{assigneeId}
        </if>
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        <if test="priority != null and priority != ''">
            AND priority = #{priority}
        </if>
        <if test="startTime != null">
            AND created_at <![CDATA[ >= ]]> #{startTime}
        </if>
        <if test="endTime != null">
            AND created_at <![CDATA[ <= ]]> #{endTime}
        </if>
    </select>

    <select id="statusDistribution" resultType="cc.ivera.ragdemo.domain.dto.TicketStatusItem">
        SELECT
        status,
        COUNT(1) AS count
        FROM work_order
        WHERE 1 = 1
        <if test="assigneeId != null and assigneeId != ''">
            AND assignee_id = #{assigneeId}
        </if>
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        <if test="priority != null and priority != ''">
            AND priority = #{priority}
        </if>
        <if test="startTime != null">
            AND created_at <![CDATA[ >= ]]> #{startTime}
        </if>
        <if test="endTime != null">
            AND created_at <![CDATA[ <= ]]> #{endTime}
        </if>
        GROUP BY status
        ORDER BY count DESC
    </select>


    <select id="queryTicketDetails" resultType="cc.ivera.ragdemo.domain.dto.TicketDetailItem">
        SELECT
        id,
        ticket_no AS ticketNo,
        title,
        status,
        priority,
        assignee_id AS assigneeId,
        assignee,
        creator,
        created_at AS createdAt,
        updated_at AS updatedAt
        FROM work_order
        <include refid="BaseWhere"/>
        ORDER BY created_at DESC
        <if test="limit != null and limit > 0">
            LIMIT #{limit}
        </if>
    </select>

</mapper>