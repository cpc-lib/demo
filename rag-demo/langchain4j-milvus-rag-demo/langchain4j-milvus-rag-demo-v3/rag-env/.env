# ============================================================
# RAG Demo Environment Configuration
# Copy this file to `.env` and adjust values as needed.
# ============================================================

# ------------------------------------------------------------
# MySQL Configuration
# ------------------------------------------------------------
MYSQL_PORT=3306
MYSQL_HOST=192.168.220.200
MYSQL_ROOT_PASSWORD=cpc!23#@
MYSQL_DATABASE=ragdemo
MYSQL_USER=ragdemo
MYSQL_PASSWORD=cpc!23#@
MYSQL_URL=jdbc:mysql://192.168.220.200:3306/ragdemo?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=ragdemo

# ------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------
REDIS_PORT=6379
REDIS_HOST=192.168.220.200
REDIS_PASSWORD=ragdemo
REDIS_DATABASE=0

# ------------------------------------------------------------
# RabbitMQ Configuration
# ------------------------------------------------------------
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_HOST=192.168.220.200
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_USER=guest
RABBITMQ_VHOST=/

# ------------------------------------------------------------
# Elasticsearch Configuration
# ------------------------------------------------------------
ES_PORT=9200
RAG_KEYWORD_INDEX_ENABLED=true
RAG_ELASTICSEARCH_BASE_URL=http://192.168.220.200:9200
RAG_ELASTICSEARCH_INDEX=rag_chunks
RAG_ELASTICSEARCH_ALIAS=rag_chunks_current
RAG_ELASTICSEARCH_INDEX_VERSION=v2
RAG_ELASTICSEARCH_ANALYZER_PROFILE=standard_zh_en
RAG_ELASTICSEARCH_TEMPLATE_MANAGED=false
RAG_ELASTICSEARCH_SYNONYM_PATH=es/synonyms.txt
RAG_ELASTICSEARCH_STOPWORD_PATH=es/stopwords.txt
RAG_ELASTICSEARCH_AUTO_CREATE_INDEX=true

# ------------------------------------------------------------
# MinIO Configuration
# IMPORTANT: Change the default credentials below for production!
# ------------------------------------------------------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
# Optional: Set a public URL for MinIO console redirect
# MINIO_BROWSER_REDIRECT_URL=http://your-server:9001

# ------------------------------------------------------------
# Milvus Configuration
# ------------------------------------------------------------
MILVUS_PORT=19530
MILVUS_HOST=192.168.220.200
MILVUS_USERNAME=root
MILVUS_PASSWORD=Milvus

# ------------------------------------------------------------
# Attu (Milvus UI) Configuration
# ------------------------------------------------------------
ATTU_PORT=8000

# ============================================================
# Application Runtime Environment Variables
# ============================================================

# ------------------------------------------------------------
# LLM Configuration
# ------------------------------------------------------------
RAG_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_LLM_API_KEY=your-llm-api-key
RAG_LLM_MODEL=qwen-plus

# ------------------------------------------------------------
# Embedding Configuration
# ------------------------------------------------------------
RAG_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBED_API_KEY=your-embedding-api-key
RAG_EMBED_MODEL=text-embedding-v4
RAG_EMBED_DIMENSION=1024

# ------------------------------------------------------------
# Web Search Configuration (optional)
# ------------------------------------------------------------
TAVILY_API_KEY=your-tavily-api-key

# ------------------------------------------------------------
# Multimodal Configuration
# ------------------------------------------------------------
RAG_MULTIMODAL_INGEST_ENABLED=true
RAG_VISION_ANALYSIS_ENABLED=true
RAG_VISION_MODEL=qwen-vl-plus

# ------------------------------------------------------------
# Object Storage
# ------------------------------------------------------------
# Type: local (filesystem) or minio
RAG_OBJECT_STORAGE_TYPE=local
RAG_OBJECT_DIR=data/rag-objects
# MinIO settings (used when RAG_OBJECT_STORAGE_TYPE=minio)
RAG_OBJECT_STORAGE_ENDPOINT=http://192.168.220.200:9000
RAG_OBJECT_STORAGE_ACCESS_KEY=minioadmin
RAG_OBJECT_STORAGE_SECRET_KEY=minioadmin
RAG_OBJECT_STORAGE_BUCKET=rag-objects

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
RAG_SECURITY_MODE=jwt
RAG_SECURITY_JWT_HMAC_SECRET=f370c74c-e318-4831-b2a1-2504fe7ea686

# ------------------------------------------------------------
# Tenant Configuration (dev mode)
# ------------------------------------------------------------
RAG_TENANT_DEV_HEADER_ENABLED=false
RAG_TENANT_ALLOW_DEMO_FALLBACK=false
