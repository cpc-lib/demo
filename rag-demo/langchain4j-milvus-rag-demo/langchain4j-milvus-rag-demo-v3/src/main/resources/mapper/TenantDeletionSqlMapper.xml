<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cc.ivera.ragdemo.mapper.TenantDeletionSqlMapper">

    <select id="countTenantRows" resultType="long">
        SELECT COUNT(*)
        FROM `${table}`
        WHERE tenant_id = #{tenantId}
    </select>

    <delete id="deleteTenantRows">
        DELETE FROM `${table}`
        WHERE tenant_id = #{tenantId}
    </delete>

</mapper>
